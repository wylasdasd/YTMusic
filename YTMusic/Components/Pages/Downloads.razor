@page "/downloads"
@page "/transfers"
@using System.Linq
@using YTMusic.Services
@implements IDisposable

<div class="ytm-page ytm-page--tabs">
    <MudTabs id="downloads-page-tabs"
             Class="ytm-tabs-touch-scroll"
             Elevation="1"
             Rounded="true"
             MinimumTabWidth="50%"
             ActivePanelIndex="ViewModel.SelectedTabIndex"
             ActivePanelIndexChanged="OnTabIndexChangedAsync">
        <MudTabPanel Text="下载任务"
                     Icon="@Icons.Material.Filled.CloudDownload"
                     BadgeData="@ViewModel.GetTasksTabBadgeData()"
                     BadgeColor="Color.Error">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 px-1">
                仅本次运行有效，关闭应用后任务列表会清空；成功写入的曲目会出现在「下载记录」。
            </MudText>
            <div class="d-flex align-center gap-2 mb-3" style="overflow-x: auto;">
                <MudChip T="string"
                         Color="@(ViewModel.TaskFilter == DownloadsVM.DownloadTaskFilter.All ? Color.Primary : Color.Default)"
                         Variant="@(ViewModel.TaskFilter == DownloadsVM.DownloadTaskFilter.All ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => ViewModel.SetTaskFilter(DownloadsVM.DownloadTaskFilter.All))">
                    全部
                </MudChip>
                <MudChip T="string"
                         Color="@(ViewModel.TaskFilter == DownloadsVM.DownloadTaskFilter.Active ? Color.Primary : Color.Default)"
                         Variant="@(ViewModel.TaskFilter == DownloadsVM.DownloadTaskFilter.Active ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => ViewModel.SetTaskFilter(DownloadsVM.DownloadTaskFilter.Active))">
                    进行中
                </MudChip>
                <MudChip T="string"
                         Color="@(ViewModel.TaskFilter == DownloadsVM.DownloadTaskFilter.Completed ? Color.Success : Color.Default)"
                         Variant="@(ViewModel.TaskFilter == DownloadsVM.DownloadTaskFilter.Completed ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => ViewModel.SetTaskFilter(DownloadsVM.DownloadTaskFilter.Completed))">
                    成功
                </MudChip>
                <MudChip T="string"
                         Color="@(ViewModel.TaskFilter == DownloadsVM.DownloadTaskFilter.Failed ? Color.Error : Color.Default)"
                         Variant="@(ViewModel.TaskFilter == DownloadsVM.DownloadTaskFilter.Failed ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => ViewModel.SetTaskFilter(DownloadsVM.DownloadTaskFilter.Failed))">
                    失败
                </MudChip>
            </div>

            @if (!ViewModel.FilteredDownloadTasks.Any())
            {
                <MudAlert Severity="Severity.Info">@DownloadsVM.GetTaskEmptyMessage(ViewModel.TaskFilter)</MudAlert>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var task in ViewModel.FilteredDownloadTasks.Reverse())
                    {
                        <MudPaper @key="task.Id" Elevation="2" Class="pa-4">
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MediaTitle Text="@task.Title"
                                            Typo="Typo.subtitle1"
                                            WrapperStyle="max-width: 70%; flex: 1; min-width: 0;" />
                                <MudChip Size="Size.Small" Color="@DownloadsVM.GetTaskStatusColor(task.Status)" T="string">
                                    @DownloadsVM.GetDownloadTaskLabel(task)
                                </MudChip>
                            </div>

                            @if (task.Status == DownloadStatus.Pending)
                            {
                                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">排队中…</MudText>
                            }
                            else if (task.Status == DownloadStatus.Downloading || task.Status == DownloadStatus.Paused)
                            {
                                <MudProgressLinear Color="Color.Primary" Value="@(task.Progress * 100)" Class="my-2" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@((task.Progress * 100).ToString("F1"))%</MudText>
                            }
                            else if (task.Status == DownloadStatus.Failed || task.Status == DownloadStatus.Cancelled)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">@task.ErrorMessage</MudText>
                            }
                            else if (!string.IsNullOrWhiteSpace(task.DestinationPath))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@task.DestinationPath</MudText>
                            }

                            @if (DownloadsVM.CanPauseOrResume(task) || DownloadsVM.CanCancel(task))
                            {
                                <div class="d-flex gap-2 mt-2 justify-end">
                                    @if (task.Status == DownloadStatus.Paused)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => ViewModel.ResumeTask(task))">继续</MudButton>
                                    }
                                    else if (task.Status is DownloadStatus.Pending or DownloadStatus.Downloading)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => ViewModel.PauseTask(task))">暂停</MudButton>
                                    }
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => ViewModel.CancelTask(task))">取消</MudButton>
                                </div>
                            }
                        </MudPaper>
                    }
                </div>
            }
        </MudTabPanel>

        <MudTabPanel Text="下载记录"
                     Icon="@Icons.Material.Filled.LibraryMusic">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 px-1">
                来自已成功完成的下载任务，写入 YTMusicDownloads.db3；重启应用后仍保留。
            </MudText>
            @if (ViewModel.IsLoading)
            {
                <div class="d-flex justify-center mt-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                </div>
            }
            else if (ViewModel.DownloadRecords.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">还没有下载记录。任务下载成功后会自动出现在这里。</MudAlert>
            }
            else
            {
                <div class="d-flex flex-column gap-3 mt-2">
                    @foreach (var file in ViewModel.DownloadRecords)
                    {
                        var hasFile = DownloadsVM.HasLocalFile(file);
                        <MudPaper Elevation="2"
                                  Class="pa-4 d-flex align-center"
                                  Style="@(hasFile ? "cursor: pointer;" : null)"
                                  @onclick="@(async () => { if (hasFile) await ViewModel.PlayLocalAudioFileAsync(file); })">
                            @if (!string.IsNullOrEmpty(file.ThumbnailUrl))
                            {
                                <MudImage Src="@file.ThumbnailUrl" Width="60" Height="60" ObjectFit="ObjectFit.Cover" Class="rounded mr-4" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.MusicNote" Size="Size.Large" Class="mr-4" Color="Color.Primary" />
                            }

                            <div class="d-flex flex-column flex-grow-1" style="overflow: hidden; min-width: 0;">
                                <MediaTitle Text="@file.Title" Typo="Typo.subtitle1" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @file.DownloadedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                    @(hasFile ? "" : " · 本地文件已缺失")
                                </MudText>
                            </div>

                            @if (file.IsVideo && hasFile)
                            {
                                <div @onclick:stopPropagation="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.OndemandVideo"
                                                   Color="Color.Secondary"
                                                   OnClick="@(() => ViewModel.PlayLocalVideoFileAsync(file))"
                                                   aria-label="Play video" />
                                </div>
                            }
                            @if (hasFile)
                            {
                                <div @onclick:stopPropagation="true">
                                    <MudIconButton
                                        Icon="@(ViewModel.FavoriteFilePaths.Contains(file.LocalFilePath) ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                                        Color="@(ViewModel.FavoriteFilePaths.Contains(file.LocalFilePath) ? Color.Error : Color.Default)"
                                        OnClick="@(async () => await ViewModel.OpenFavoriteDialogAsync(file))"
                                        aria-label="Toggle Favorite" />
                                </div>
                            }
                            @if (DownloadsVM.CanRedownloadFromYouTube(file))
                            {
                                <div @onclick:stopPropagation="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.CloudDownload"
                                                   Color="Color.Info"
                                                   OnClick="@(() => ViewModel.RedownloadAsync(file))"
                                                   aria-label="重新下载" />
                                </div>
                            }
                            @if (hasFile)
                            {
                                <div @onclick:stopPropagation="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => ViewModel.PlayLocalAudioFileAsync(file))"
                                                   aria-label="Play audio" />
                                </div>
                            }
                            <div @onclick:stopPropagation="true">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               OnClick="@(() => ViewModel.DeleteFileAsync(file))"
                                               aria-label="删除下载记录" />
                            </div>
                        </MudPaper>
                    }
                </div>
            }
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    private const string DownloadsTabsId = "downloads-page-tabs";

    [Inject] private DownloadsVM ViewModel { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.StateHasChanged = () => InvokeAsync(StateHasChanged);
        ApplyTabFromQuery();
        await ViewModel.LoadDownloadRecordsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("ytmLayout.initTouchScrollTabs", DownloadsTabsId);
        }
    }

    private void ApplyTabFromQuery()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (uri.AbsolutePath.Contains("/transfers", StringComparison.OrdinalIgnoreCase))
        {
            ViewModel.ApplyRouteTab("tasks");
            return;
        }

        var query = uri.Query;
        if (query.Contains("tab=tasks", StringComparison.OrdinalIgnoreCase))
        {
            ViewModel.ApplyRouteTab("tasks");
        }
        else if (query.Contains("tab=records", StringComparison.OrdinalIgnoreCase))
        {
            ViewModel.ApplyRouteTab("records");
        }
    }

    private async Task OnTabIndexChangedAsync(int index)
    {
        ViewModel.SelectedTabIndex = index;
        if (index == 1)
        {
            await ViewModel.LoadDownloadRecordsAsync(showLoadingSpinner: false);
        }
    }

    public void Dispose()
    {
        ViewModel.Dispose();
        ViewModel.StateHasChanged = null;
    }
}
