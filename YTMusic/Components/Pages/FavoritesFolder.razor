@page "/favorites/folder/{FolderId:int}"
@using YTMusic.Services
@implements IDisposable

<PageListScroll PageKey="@($"favorites-folder-{FolderId}")" ScrollId="favorites-folder-scroll">
    <Header>
        <div class="favorites-track-toolbar">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Color="Color.Default"
                           OnClick="ViewModel.NavigateBackToFolderList"
                           aria-label="返回收藏夹列表" />
            <MudText Typo="Typo.h6" Class="favorites-track-toolbar__title">
                @(ViewModel.FolderName ?? "收藏夹")
            </MudText>
        </div>
        <div class="favorites-sort-field">
            <MudSelect T="FavoriteTrackSortMode"
                       Value="ViewModel.SortMode"
                       ValueChanged="ViewModel.SetSortModeAsync"
                       Label="排序方式"
                       Variant="Variant.Outlined"
                       FullWidth="true"
                       Dense="true">
                <MudSelectItem T="FavoriteTrackSortMode" Value="FavoriteTrackSortMode.Time">时间</MudSelectItem>
                <MudSelectItem T="FavoriteTrackSortMode" Value="FavoriteTrackSortMode.Name">名称</MudSelectItem>
                @if (!ViewModel.IsDownloadedCatalog && !ViewModel.IsLocalLibrary)
                {
                    <MudSelectItem T="FavoriteTrackSortMode" Value="FavoriteTrackSortMode.Downloaded">已下载</MudSelectItem>
                    <MudSelectItem T="FavoriteTrackSortMode" Value="FavoriteTrackSortMode.NotDownloaded">未下载</MudSelectItem>
                }
            </MudSelect>
        </div>
        @if (ViewModel.IsDownloadedCatalog)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                已下载按存放目录分组，展开后查看曲目。可通过爱心按钮收藏到其他收藏夹。
            </MudAlert>
        }
        else if (ViewModel.IsLocalLibrary)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                来自本地文件夹，按存放目录分组。删除这个收藏夹不会删除磁盘上的文件。
            </MudAlert>
        }
    </Header>
    <ChildContent>
        @if (ViewModel.IsLoading)
        {
            <div class="d-flex justify-center mt-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else if (!ViewModel.Tracks.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">
                @(ViewModel.IsDownloadedCatalog ? "暂无本地下载文件。" : ViewModel.IsLocalLibrary ? "这个文件夹里没有音频文件。" : "当前收藏夹没有符合条件的歌曲。")
            </MudAlert>
        }
        else if (ViewModel.UsesDirectoryGroups)
        {
            <div class="local-library mt-2">
                @foreach (var node in ViewModel.DirectoryNodes)
                {
                    <LocalDirectoryGroup TItem="FavoriteTrack"
                                         Node="node"
                                         PlayRequested="ViewModel.PlayDirectoryAsync">
                        <TrackRow Context="track">
                            <MudPaper Elevation="0"
                                      Class="local-dir__track pa-2 d-flex align-center"
                                      @onclick="@(() => ViewModel.PlayTrackAsync(track))">
                                @if (UiPreferences.ShowFavoriteCardImages && !string.IsNullOrWhiteSpace(track.ThumbnailUrl))
                                {
                                    <MudImage Src="@track.ThumbnailUrl"
                                              Width="44"
                                              Height="44"
                                              ObjectFit="ObjectFit.Cover"
                                              Class="rounded mr-3" />
                                }
                                else
                                {
                                    <div class="local-dir__track-icon mr-3">
                                        <MudIcon Icon="@Icons.Material.Filled.MusicNote" Color="Color.Primary" Size="Size.Small" />
                                    </div>
                                }

                                <div class="local-dir__meta flex-grow-1">
                                    <MediaTitle Text="@track.Title" Typo="Typo.body1" />
                                    @if (!string.IsNullOrWhiteSpace(track.Author))
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@track.Author</MudText>
                                    }
                                </div>

                                @if (track.HasDownloadedVideo)
                                {
                                    <div @onclick:stopPropagation="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.OndemandVideo"
                                                       Color="Color.Secondary"
                                                       OnClick="@(async () => await ViewModel.PlayLocalVideoAsync(track))"
                                                       aria-label="播放本地视频" />
                                    </div>
                                }
                                <div @onclick:stopPropagation="true">
                                    <MudIconButton Icon="@(ViewModel.IsTrackFavoritedAnywhere(track) ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                                                   Color="@(ViewModel.IsTrackFavoritedAnywhere(track) ? Color.Error : Color.Default)"
                                                   OnClick="@(async () => await ViewModel.OpenFavoriteFolderDialogAsync(track))"
                                                   aria-label="管理收藏夹" />
                                </div>
                                @if (ViewModel.IsDownloadedCatalog)
                                {
                                    <div @onclick:stopPropagation="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       OnClick="@(async () => await ViewModel.DeleteLocalFileAsync(track))"
                                                       aria-label="删除本地文件" />
                                    </div>
                                }
                            </MudPaper>
                        </TrackRow>
                    </LocalDirectoryGroup>
                }
            </div>
        }
        else
        {
            <MudGrid Class="mt-2 justify-center">
                @foreach (var track in ViewModel.Tracks)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="2" Style="height: 100%; display: flex; flex-direction: column; cursor: pointer;"
                                 @onclick="@(() => ViewModel.PlayTrackAsync(track))">
                            @if (UiPreferences.ShowFavoriteCardImages)
                            {
                                <MudCardMedia Image="@track.ThumbnailUrl" Height="160" />
                            }
                            <MudCardContent Style="flex-grow: 1;">
                                <MediaTitle Text="@track.Title" Typo="Typo.subtitle1" />
                            </MudCardContent>
                            <MudCardActions Class="favorites-card__footer">
                                @if (track.IsDownloaded)
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Success"
                                             Variant="Variant.Outlined"
                                             Icon="@Icons.Material.Filled.CheckCircle">
                                        Downloaded
                                    </MudChip>
                                }
                                <MudSpacer />
                                @if (track.HasDownloadedVideo)
                                {
                                    <div @onclick:stopPropagation="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.OndemandVideo"
                                                       Color="Color.Secondary"
                                                       OnClick="@(async () => await ViewModel.PlayLocalVideoAsync(track))"
                                                       aria-label="Play local video" />
                                    </div>
                                }
                                <div @onclick:stopPropagation="true">
                                    <MudIconButton
                                        Icon="@(ViewModel.IsTrackFavoritedAnywhere(track) ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                                        Color="@(ViewModel.IsTrackFavoritedAnywhere(track) ? Color.Error : Color.Default)"
                                        OnClick="@(async () => await ViewModel.OpenFavoriteFolderDialogAsync(track))"
                                        aria-label="管理收藏夹" />
                                </div>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </ChildContent>
</PageListScroll>

@code {
    [Parameter] public int FolderId { get; set; }

    [Inject] private FavoritesFolderVM ViewModel { get; set; } = default!;
    [Inject] private UiPreferencesService UiPreferences { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.StateHasChanged = StateHasChanged;
        UiPreferences.OnChange += OnUiPreferencesChanged;
        await ViewModel.InitializeAsync(FolderId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (FolderId != ViewModel.FolderId && FolderId != 0)
        {
            await ViewModel.InitializeAsync(FolderId);
        }
    }

    public void Dispose()
    {
        ViewModel.StateHasChanged = null;
        UiPreferences.OnChange -= OnUiPreferencesChanged;
    }

    private void OnUiPreferencesChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }
}
