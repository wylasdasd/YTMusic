@page "/search"
@using Microsoft.JSInterop
@using YTMusic.Services
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageListScroll PageKey="search" ScrollId="search-page-scroll">
    <Header>
        <section class="search-toolbar">
            <MudTextField @bind-Value="ViewModel.Query"
                          Label="Search songs, artists, albums"
                          Placeholder="Try:teto,miku"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          FullWidth="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          OnAdornmentClick="@(async () => await ViewModel.SearchCommand.ExecuteAsync(null))"
                          OnKeyUp="@(async e => { if (e.Key == "Enter") await ViewModel.SearchCommand.ExecuteAsync(null); })" />
        </section>
    </Header>
    <ChildContent>
        @if (ViewModel.Videos.Any())
        {
            <MudGrid Class="search-grid">
                @foreach (var video in ViewModel.Videos)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="0" Class="ytm-card" @onclick="@(() => ViewModel.PlayAndNavigateAsync(video))">
                            <div class="ytm-card__media-wrap">
                                <MudCardMedia Image="@video.Thumbnails.FirstOrDefault()?.Url" Height="176" />
                                <div class="ytm-card__media-mask"></div>
                                <span class="ytm-card__duration">@video.Duration</span>
                            </div>

                            <MudCardContent Class="ytm-card__content">
                                <MediaTitle Text="@video.Title" Typo="Typo.subtitle1" Class="ytm-card__title" />
                                <MudText Typo="Typo.body2" Class="ytm-card__artist">@video.Author.ChannelTitle</MudText>
                            </MudCardContent>

                            <MudCardActions Class="ytm-card__actions">
                                <MudIconButton Icon="@Icons.Material.Filled.PlayCircle" Color="Color.Primary" aria-label="Play" />
                                <MudSpacer />
                                <MudIconButton
                                    Icon="@(ViewModel.FavoriteVideoIds.Contains(video.Id.Value) ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                                    Color="@(ViewModel.FavoriteVideoIds.Contains(video.Id.Value) ? Color.Error : Color.Default)"
                                    OnClick="@(async (e) => await ViewModel.OpenFavoriteDialogAsync(video))"
                                    aria-label="Toggle Favorite" />
                                <div @onclick:stopPropagation="true">
                                    <MudMenu Icon="@Icons.Material.Filled.Download" Color="Color.Default"
                                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="Download">
                                        <MudMenuItem OnClick="@(() => ViewModel.Download(video, false))">Download Audio</MudMenuItem>
                                    </MudMenu>
                                </div>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>

            @if (ViewModel.HasMore || ViewModel.IsSearching)
            {
                <div @ref="_scrollEndSentinel" class="search-scroll-end">
                    @if (ViewModel.IsSearching)
                    {
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                        <span class="ms-2">Loading...</span>
                    }
                </div>
            }
        }
        else if (ViewModel.IsSearching)
        {
            <div class="d-flex justify-center mt-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ViewModel.Query))
        {
            <MudPaper Elevation="0" Class="search-empty">
                <MudText Typo="Typo.h6">No results found</MudText>
            </MudPaper>
        }
    </ChildContent>
</PageListScroll>

@code {
    private const string ScrollEndKey = "search";
    private const string ScrollRootId = "search-page-scroll";

    private ElementReference _scrollEndSentinel;
    private DotNetObjectReference<Search>? _objRef;
    private bool _scrollEndBound;
    private int _observedVideoCount = -1;

    [Inject] private SearchVM ViewModel { get; set; } = default!;

    protected override void OnInitialized()
    {
        ViewModel.StateHasChanged = StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ViewModel.Videos.Count > 0 && ViewModel.HasMore && !ViewModel.IsSearching)
        {
            // 每次翻页后重绑，sentinel 仍在视口内时才能继续自动加载
            if (!_scrollEndBound || _observedVideoCount != ViewModel.Videos.Count)
            {
                _observedVideoCount = ViewModel.Videos.Count;
                await EnsureScrollEndObserverAsync();
            }
        }
        else if (_scrollEndBound)
        {
            await DisposeScrollEndObserverAsync();
            _observedVideoCount = -1;
        }
    }

    private async Task EnsureScrollEndObserverAsync()
    {
        _objRef ??= DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync(
            "ytmLayout.observeScrollEnd",
            ScrollEndKey,
            _scrollEndSentinel,
            ScrollRootId,
            _objRef,
            nameof(OnScrollEndReachedAsync));
        _scrollEndBound = true;
    }

    private async Task DisposeScrollEndObserverAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("ytmLayout.disposeScrollEnd", ScrollEndKey);
        }
        catch (JSDisconnectedException)
        {
        }

        _scrollEndBound = false;
    }

    [JSInvokable]
    public Task OnScrollEndReachedAsync()
    {
        return InvokeAsync(async () =>
        {
            if (!ViewModel.HasMore || ViewModel.IsSearching)
            {
                return;
            }

            await ViewModel.LoadNextPageCommand.ExecuteAsync(null);
        });
    }

    public void Dispose()
    {
        if (_scrollEndBound)
        {
            _ = JSRuntime.InvokeVoidAsync("ytmLayout.disposeScrollEnd", ScrollEndKey);
            _scrollEndBound = false;
        }

        _objRef?.Dispose();
        _objRef = null;
        ViewModel.Dispose();
        ViewModel.StateHasChanged = null;
    }
}
