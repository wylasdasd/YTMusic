@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="FolderName"
                      Label="收藏夹名称"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      FullWidth="true"
                      MaxLength="64"
                      Counter="64"
                      Placeholder="例如：工作、通勤" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">取消</MudButton>
        <MudButton OnClick="Confirm" Color="Color.Primary" Variant="Variant.Filled" Disabled="@string.IsNullOrWhiteSpace(FolderName)">
            @ConfirmText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? InitialName { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "创建";

    private string FolderName { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        FolderName = InitialName ?? string.Empty;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Confirm()
    {
        MudDialog.Close(DialogResult.Ok(FolderName.Trim()));
    }
}
